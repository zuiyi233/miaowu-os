# Miaowu v1 production multi-region env template.
# Copy to .env.production on each node and fill secrets locally.
# All gateway nodes must share the same database, storage, JWT, crypto, OIDC,
# and NewAPI provider settings.

MIAOWU_INSTANCE_NAME=replace-with-node-name
MIAOWU_PUBLIC_DOMAIN=xs.miaowu.bond
MIAOWU_FRONTEND_IMAGE_TAG=miaowu-os-frontend:replace-git-sha-yyyymmdd
MIAOWU_GATEWAY_IMAGE_TAG=miaowu-os-gateway:replace-git-sha-yyyymmdd
PORT=4560
GATEWAY_WORKERS=4

# Database: v1 uses the 31 candidate PostgreSQL primary.
DATABASE_URL=postgresql://miaowu:replace-password@replace-31-postgres-host:5432/miaowu

# Auth and encryption: identical on every production gateway.
AUTH_JWT_SECRET=replace-with-same-long-random-secret-on-all-gateways
CRYPTO_SECRET=replace-with-same-long-random-secret-on-all-gateways
BETTER_AUTH_SECRET=replace-with-same-long-random-secret-on-all-frontends

# Public origins and callback.
CORS_ORIGINS=https://xs.miaowu.bond
GATEWAY_CORS_ORIGINS=https://xs.miaowu.bond
DEER_FLOW_TRUSTED_ORIGINS=https://xs.miaowu.bond
DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://gateway:8551

# NewAPI OIDC. Do not repurpose xg.miaowu.bond; it remains NewAPI.
NEWAPI_OAUTH_ENABLED=true
NEWAPI_OAUTH_ISSUER=https://replace-existing-newapi-domain
NEWAPI_OAUTH_CLIENT_ID=replace-newapi-oidc-client-id
NEWAPI_OAUTH_CLIENT_SECRET=replace-newapi-oidc-client-secret
NEWAPI_OAUTH_REDIRECT_URI=https://xs.miaowu.bond/api/v1/auth/callback/newapi
NEWAPI_OAUTH_SCOPES=openid profile email
MIAOWU_PUBLIC_FRONTEND_URL=https://xs.miaowu.bond
NEWAPI_OAUTH_ADMIN_SUBS=
NEWAPI_OAUTH_ADMIN_IDENTITIES=
NEWAPI_OAUTH_SYNC_ADMIN_DOWNGRADE=false

# Server-managed NewAPI model groups. Browsers see metadata/model names only.
MIAOWU_NEWAPI_GROUPS_JSON=[{"id":"default","name":"默认分组","base_url":"https://replace-existing-newapi-domain/v1","api_key":"replace-newapi-group-key"}]

# Object storage: current v1 truth is 161/162 VIP-backed SeaweedFS/S3-compatible.
MIAOWU_OBJECT_STORAGE_PROVIDER=s3
MIAOWU_OBJECT_STORAGE_ENDPOINT=http://172.22.22.170:18334
MIAOWU_OBJECT_STORAGE_BUCKET=miaowu-novel-assets
MIAOWU_OBJECT_STORAGE_REGION=us-east-1
MIAOWU_OBJECT_STORAGE_ACCESS_KEY=replace-seaweedfs-access-key
MIAOWU_OBJECT_STORAGE_SECRET_KEY=replace-seaweedfs-secret-key
MIAOWU_OBJECT_STORAGE_PRIVATE=true

# Generic aliases are supported, but Miaowu-specific names above take precedence.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://172.22.22.170:18334
S3_BUCKET_NAME=miaowu-novel-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-seaweedfs-access-key
S3_SECRET_ACCESS_KEY=replace-seaweedfs-secret-key
S3_PATH_STYLE=true
S3_PUBLIC_DOMAIN=

# Disable public API docs in production unless explicitly needed.
GATEWAY_ENABLE_DOCS=false
